# RepoRAG Environment Configuration
# API Keys (Optional for demo & mock modes; required for live cloud LLM & higher GitHub rate limits)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Providers: "gemini", "openai", "local" (defaults to smart offline synthesizer if key not provided)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=


# Vector Database: "chroma" or "memory"
VECTOR_DB_TYPE=memory
VECTOR_DB_DIR=./data/vector_db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://*
SECRET_KEY=reporag-super-secret-key-change-in-production
